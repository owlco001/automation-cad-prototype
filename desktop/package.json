{
  "name": "automation-cad-desktop",
  "version": "0.6.5",
  "private": true,
  "license": "GPL-3.0-only",
  "description": "非标自动化整机设计软件 · Windows 11 桌面版",
  "author": "owlco",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "build:ext": "tsc --noEmit && vite build && node scripts/build-electron.mjs && node scripts/build-mcp.mjs && node scripts/check-bundle-size.mjs",
    "check:bundle-size": "node scripts/check-bundle-size.mjs",
    "check:electron-bundle": "node scripts/check-electron-bundle-security.mjs dist-electron/main.cjs",
    "bench:motion": "node ../scripts/bench-motion-envelope.mjs",
    "start": "electron .",
    "test": "node --test",
    "test:cli": "node --test test/machine/cli.test.mjs",
    "test:focused": "node --test test/cad/scene-integrity.test.mjs test/machine/build-scene-gate.test.mjs test/machine/buffer-io-map.test.mjs test/machine/buffer-io.test.mjs test/machine/buffer-control.test.mjs test/machine/buffer-tower.test.mjs test/machine/buffer-capacity.test.mjs test/machine/buffer-tower-assembly.test.mjs test/machine/buffer-tower-model.test.mjs test/machine/panel-channel.test.mjs test/machine/buffer-tower-channel.test.mjs test/machine/conveyor-assembly.test.mjs test/machine/model-builders.test.mjs test/machine/pv-buffer-regenerate.test.mjs test/agent/build-machine-model.test.mjs test/agent/design-machine.test.mjs test/agent/interference-panel-diagnostics.test.mjs test/parametric/verify-step-tower.test.mjs test/cad/render-plan.test.mjs test/cad/render-batch.test.mjs",
    "regen:pv-buffer": "node scripts/pv-buffer-regenerate.mjs",
    "sync:e2e": "bash ../scripts/sync-e2e.sh",
    "eval:agent": "node eval/run-eval.mjs",
    "eval:tasks": "node scripts/eval-tasks.mjs",
    "eval:agent:multiturn": "node scripts/agent-multiturn.mjs",
    "kb:build": "node scripts/build-kb.mjs",
    "build:machine-case": "node scripts/build-machine-case.mjs",
    "bench:render": "node scripts/bench-render-plan.mjs",
    "smoke": "xvfb-run -a node scripts/electron-run.mjs --headless-smoke",
    "machine:e2e": "npm run build:ext && node scripts/machine-e2e.mjs",
    "gate:materials": "node scripts/gate-material-colors.mjs",
    "verify:step": "node scripts/verify-step-export.mjs",
    "verify:step-tower": "node scripts/verify-step-tower.mjs",
    "verify:channel": "node scripts/verify-channel.mjs",
    "doctor:sidecar": "node scripts/sidecar-doctor.mjs",
    "smoke:design:webgl": "xvfb-run -a -s \"-screen 0 1920x1200x24\" node scripts/electron-run.mjs --headless-design-webgl-smoke",
    "smoke:win": "electron . --headless-smoke --disable-gpu --disable-gpu-compositing --disable-software-rasterizer",
    "update:installed": "node scripts/update-installed.mjs",
    "diagnose": "xvfb-run -a node scripts/electron-run.mjs --diagnose",
    "diagnose:win": "electron . --diagnose --disable-gpu --disable-gpu-compositing --disable-software-rasterizer",
    "packs:validate": "node ../scripts/pack-validate.mjs",
    "packs:stats": "node ../scripts/pack-stats.mjs",
    "packs:add": "node ../scripts/pack-add.mjs",
    "perf:baseline": "node --expose-gc scripts/perf-baseline.mjs",
    "check:orbit-webgl": "xvfb-run -a -s \"-screen 0 1700x1100x24\" node scripts/electron-run.mjs scripts/orbit-webgl-check.cjs",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "screenshots:machine": "npm run build:ext && node scripts/capture-machine-screenshots.mjs",
    "screenshots:wizard": "npm run build:ext && node scripts/capture-wizard-screenshots.mjs",
    "screenshots:linkage": "npm run build:ext && node scripts/capture-linkage-screenshots.mjs",
    "screenshots:agent": "npm run build:ext && node scripts/capture-agent-screenshots.mjs",
    "screenshots:library": "npm run build:ext && node scripts/capture-library-screenshot.mjs",
    "dist:win": "node scripts/vendor-qt.mjs && node scripts/build-pipeline.mjs && node scripts/vendor-dwg.mjs && electron-builder --win nsis --x64",
    "dist:win:core": "node scripts/dist-win-core.mjs",
    "build:mcp": "node scripts/build-mcp.mjs",
    "mcp": "node dist-electron/mcp.cjs",
    "agent:live": "node scripts/agent-live.mjs",
    "agent:report": "node scripts/agent-report.mjs",
    "smoke:mcp": "xvfb-run -a node scripts/smoke-mcp.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.2",
    "adm-zip": "^0.5.16",
    "dxf-writer": "^1.18.4",
    "electron-updater": "6.8.11",
    "modbus-serial": "^8.0.25",
    "mqtt": "^5.14.1",
    "node-opcua": "2.186.15",
    "occt-import-js": "0.0.23",
    "three": "^0.186.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^24.7.2",
    "@types/three": "^0.186.0",
    "electron": "^45.2.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.11",
    "typescript": "^5.9.3",
    "vite": "^7.1.10"
  },
  "build": {
    "appId": "cn.automationcad.desktop",
    "productName": "AutomationCAD",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "!**/*.map",
      "!**/*.ts",
      "!**/*.cts",
      "!**/*.mts",
      "!**/*.tsbuildinfo",
      "!**/{test,tests,__tests__}/**",
      "!**/*.iobj",
      "!**/*.ipdb",
      "!**/*.tlog",
      "!**/*.exp",
      "!**/*.lib",
      "!dist-electron/occt-import-js.wasm"
    ],
    "extraResources": [
      {
        "from": "../packs/builtin",
        "to": "packs/builtin"
      },
      {
        "from": "../index.html",
        "to": "web/index.html"
      },
      {
        "from": "../app.js",
        "to": "web/app.js"
      },
      {
        "from": "../styles.css",
        "to": "web/styles.css"
      },
      {
        "from": "../electrical.js",
        "to": "web/electrical.js"
      },
      {
        "from": "../electrical.css",
        "to": "web/electrical.css"
      },
      {
        "from": "../spike/build123d/app.py",
        "to": "parametric/app.py"
      },
      {
        "from": "../spike/freecad/techdraw_job.py",
        "to": "freecad/techdraw_job.py"
      },
      {
        "from": "vendor/dwg",
        "to": "dwg"
      },
      {
        "from": "vendor/qt",
        "to": "qt"
      },
      {
        "from": "vendor/pipeline",
        "to": "pipeline"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "owlco001",
      "repo": "automation-cad-prototype",
      "channel": "latest"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "verifyUpdateCodeSignature": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "differentialPackage": true,
      "artifactName": "AutomationCAD-Setup-${version}.${ext}"
    }
  }
}
