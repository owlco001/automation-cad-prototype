HEADER;
/* machine-e2e 内核桩产物的样子：按特征尺寸估的方块，不是真 B-Rep。
 * 头部、包络都能对上参数（6000x1495x930），但只有 1 个实体、6 个面、约 3 KB，
 * 没有孔/槽/滚筒。verify:step 必须判它 FAIL —— 证明门禁不是只看包络放行。 */
FILE_DESCRIPTION(('MACHINE_E2E parametric stub box'),'2;1');
FILE_NAME('step-stub-3kb.step','2026-11-04T00:00:00',('machine-e2e stub'),(''),
